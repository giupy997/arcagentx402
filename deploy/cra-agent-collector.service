# Bare-metal alternative to docker-compose (Node 22 + Postgres installed on the host).
# sudo cp deploy/cra-agent-collector.service /etc/systemd/system/ && sudo systemctl enable --now cra-agent-collector
[Unit]
Description=cra-agent collector (Arc block-zero data collector)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=arc
WorkingDirectory=/opt/cra-agent
EnvironmentFile=/opt/cra-agent/.env
ExecStart=/usr/bin/node packages/collector/dist/main.js
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=40
LimitNOFILE=65536
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/cra-agent

[Install]
WantedBy=multi-user.target
