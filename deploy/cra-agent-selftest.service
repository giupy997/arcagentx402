[Unit]
Description=cra-agent hourly self-test: the rail buys its own endpoint and checks the receipt
After=network-online.target cra-agent-api.service

[Service]
Type=oneshot
User=craagent
WorkingDirectory=/opt/cra-agent
# DATABASE_URL comes from here, so the self-test ledger sits next to the collector data.
EnvironmentFile=/opt/cra-agent/.env
Environment=CRA_NETWORK=arc
Environment=CRA_AGENT_ID=selftest
Environment=CRA_IDENTITY=off
Environment=CRA_KEY_FILE=/opt/cra-agent/.secrets/selftest.key
# Tight on purpose: half a cent a day, this host only. A leaked key cannot do more than that per day.
Environment=CRA_POLICY=daily=0.05,per_seller=0.05,per_payment=0.001,allow=api.cra-agent.tech
ExecStart=/usr/bin/node packages/mcp/dist/cli/rail.js selftest
TimeoutStartSec=120
