{
  "name": "@cra-agent/seller",
  "version": "0.0.5",
  "description": "Put a USDC price on any API with x402, settled on Arc: one command in front of an API you already run, or a middleware for Hono and Express.",
  "keywords": [
    "agent-payments",
    "ai-agents",
    "api-monetization",
    "arc",
    "circle",
    "circle-gateway",
    "express",
    "hono",
    "micropayments",
    "middleware",
    "paywall",
    "usdc",
    "x402"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./express": {
      "types": "./dist/express.d.ts",
      "default": "./dist/express.js"
    }
  },
  "bin": {
    "cra-agent-sell": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@circle-fin/x402-batching": "^3.4.0",
    "@coinbase/x402": "^2.1.0",
    "@x402/core": "^2.25.0",
    "@x402/evm": "^2.25.0",
    "@x402/express": "^2.25.0",
    "@x402/extensions": "^2.26.0",
    "@x402/hono": "^2.25.0",
    "@hono/node-server": "^1.14.0",
    "hono": ">=4",
    "@cra-agent/accounting": "0.0.5"
  },
  "peerDependencies": {
    "express": ">=4",
    "hono": ">=4"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "hono": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/giupy997/arcagentx402.git",
    "directory": "packages/seller"
  },
  "homepage": "https://cra-agent.tech",
  "bugs": {
    "url": "https://github.com/giupy997/arcagentx402/issues"
  },
  "author": "cra-agent"
}
