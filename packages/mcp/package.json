{
  "name": "@cra-agent/mcp",
  "version": "0.0.3",
  "description": "MCP server and CLI that let an AI agent pay for x402 APIs in USDC on Arc, under a spending policy the model cannot change.",
  "keywords": [
    "agent-payments",
    "ai-agents",
    "arc",
    "circle",
    "circle-gateway",
    "claude",
    "cli",
    "mcp",
    "mcp-server",
    "micropayments",
    "model-context-protocol",
    "nanopayments",
    "usdc",
    "x402"
  ],
  "type": "module",
  "main": "./dist/server.js",
  "bin": {
    "cra-agent-mcp": "dist/server.js",
    "cra-agent": "dist/cli/rail.js"
  },
  "scripts": {
    "build": "tsc -b",
    "start": "node --env-file-if-exists=../../.env --import tsx src/server.ts",
    "cli": "node --env-file-if-exists=../../.env --import tsx src/cli/rail.ts"
  },
  "dependencies": {
    "@cra-agent/accounting": "0.0.3",
    "@cra-agent/identity": "0.0.3",
    "@cra-agent/ledger": "0.0.3",
    "@cra-agent/policy": "0.0.3",
    "@cra-agent/router": "0.0.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.0",
    "@cra-agent/escrow": "0.0.3",
    "viem": "^2.31.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/giupy997/arcagentx402.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://cra-agent.tech",
  "bugs": {
    "url": "https://github.com/giupy997/arcagentx402/issues"
  },
  "author": "cra-agent",
  "mcpName": "io.github.giupy997/cra-agent"
}
