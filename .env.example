# ---- cra-agent collector ----
# Network profile: "testnet" or "mainnet". Chain ID is asserted at startup against eth_chainId.
ARC_NETWORK=testnet
# Override the expected chain id (default: 5042002 for testnet, 5042 for mainnet — mainnet value
# must be re-verified on docs.arc.io at launch).
# ARC_CHAIN_ID=5042002
# Comma-separated JSON-RPC HTTP endpoints, in priority order. First is preferred.
ARC_RPC_URLS=https://rpc.testnet.arc.io,https://rpc.drpc.testnet.arc.io,https://rpc.quicknode.testnet.arc.io,https://rpc.blockdaemon.testnet.arc.io
# Optional keyed providers (appended to the pool if set)
# ALCHEMY_ARC_URL=https://arc-testnet.g.alchemy.com/v2/YOUR_KEY
DATABASE_URL=postgres://localhost:5432/arc_rail_dev
# Block to start from when the DB is empty (genesis = 0). Backfill always targets 0 regardless.
COLLECTOR_START_BLOCK=0
# Backfill the range [0, COLLECTOR_START_BLOCK-1] in the background (1 = yes). Keep 1 on mainnet.
COLLECTOR_BACKFILL_HISTORY=1
# How many blocks to fetch concurrently while catching up.
COLLECTOR_CONCURRENCY=4
# Alert if the collector is more than this many blocks behind the chain head.
COLLECTOR_LAG_ALERT_BLOCKS=200
# Health HTTP server port (GET /health, GET /metrics)
COLLECTOR_HEALTH_PORT=8790
# Optional Telegram alerts
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Collector mode: light (blocks, per-block stats, deploys, RPC observations; ~0.4 GB/day) or full (+ transactions, receipts, logs, reverts; ~12-16 GB/day)
COLLECTOR_MODE=light
# Free-space alert on this path (the Postgres volume), in GB
COLLECTOR_DISK_PATH=/
COLLECTOR_DISK_ALERT_GB=40
# Raw JSON storage: compact (default, lossless: calldata in transactions.input, logs in logs table) or full (verbatim duplicates, ~2x disk)
COLLECTOR_RAW_MODE=compact
# Best-effort revert reason enrichment for failed txs (eth_call replay at parent block). 1 = on.
COLLECTOR_ENRICH_REVERTS=1
LOG_LEVEL=info

# ---- agent (router / mcp) ----
# CRA_NETWORK=arcTestnet
# CRA_KEY_FILE=/path/to/agent.key          # or CRA_PRIVATE_KEY=0x… (chmod 600, never in chat)
# CRA_POLICY=daily=5,per_seller=0.5,per_payment=0.05,rate=120/60s,identity=required
# CRA_AGENT_ID=my-agent
# ---- seller (api paid routes) ----
# SELLER_ADDRESS=0x…                            # enables /v1/paid/* priced via x402 + Circle Gateway
