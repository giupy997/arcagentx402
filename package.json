{
  "name": "arc-rail",
  "private": true,
  "version": "0.0.1",
  "description": "Agentic payment rail on Arc. Phase 0: block-zero data collector.",
  "type": "module",
  "engines": { "node": ">=22" },
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b packages/accounting packages/collector",
    "lint": "tsc -b --noEmit packages/accounting packages/collector",
    "collector": "npm run start -w @arc-rail/collector --",
    "db:migrate": "npm run migrate -w @arc-rail/collector --"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "fast-check": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
